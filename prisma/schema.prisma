generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Product {
  id                  String   @id @default(cuid())
  title               String
  slug                String   @unique
  sku                 String   @unique
  barcode             String?
  externalStockId     String?
  externalProvider    String?
  stockSource         String   @default("local")
  lastStockSyncAt     DateTime?
  lastStockSyncStatus String?
  lastStockSyncError  String?
  shortDescription    String?
  description         String?
  priceCents          Int
  stock               Int      @default(0)
  status              String   @default("draft")
  shippingClass       String   @default("M")
  estimatedWeightGrams Int     @default(0)
  isFragile           Boolean  @default(false)
  pickupOnly          Boolean  @default(false)
  imageStatus         String?
  imageSource         String?
  imageAlt            String?
  imageUpdatedAt      DateTime?
  imageValidatedAt    DateTime?
  seoTitle            String?
  seoDescription      String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  images     ProductImage[]
  categories ProductCategory[]
  orderItems OrderItem[]
  shopcaisseCacheLinks ShopcaisseProductCache[]
}

model ProductImage {
  id              String   @id @default(cuid())
  productId       String
  url             String
  alt             String?
  position        Int      @default(0)
  storageProvider String   @default("r2")
  storageKey      String?
  mimeType        String?
  width           Int?
  height          Int?
  sizeBytes       Int?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @default(now()) @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model Category {
  id               String   @id @default(cuid())
  title            String
  slug             String   @unique
  description      String?
  externalFamilyId String?  @unique
  position         Int      @default(0)
  source           String   @default("local")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  products ProductCategory[]
}

model ProductCategory {
  productId  String
  categoryId String

  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([productId, categoryId])
}

model Order {
  id                    String   @id @default(cuid())
  orderNumber           String   @unique
  customerId            String?
  customerEmail         String
  customerFirstName     String
  customerLastName      String
  customerPhone         String?
  shippingAddressLine1  String?
  shippingAddressLine2  String?
  shippingPostalCode    String?
  shippingCity          String?
  shippingCountry       String?
  subtotalCents         Int
  shippingCostCents     Int
  totalCents            Int
  currency              String   @default("eur")
  paymentStatus         String   @default("pending")
  orderStatus           String   @default("pending")
  shippingMethod        String
  stripeSessionId       String?  @unique
  stripePaymentIntentId String?
  trackingToken         String?  @unique
  trackingTokenExpiresAt DateTime?
  carrier               String?
  trackingNumber        String?
  labelUrl              String?
  labelGeneratedAt      DateTime?
  shippedAt             DateTime?
  deliveredAt           DateTime?
  shopcaisseSyncStatus  String?
  shopcaisseSyncAt      DateTime?
  shopcaisseSyncError   String?
  stockDecrementedAt     DateTime?
  analyticsPurchaseTrackedAt DateTime?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  customer Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  items OrderItem[]
}

model OrderItem {
  id             String @id @default(cuid())
  orderId        String
  productId      String?
  title          String
  sku            String
  quantity       Int
  unitPriceCents Int
  lineTotalCents Int

  order   Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
}

model BlogPost {
  id              String    @id @default(cuid())
  title           String
  slug            String    @unique
  excerpt         String?
  content         String
  imageUrl        String?
  imageAlt        String?
  category        String?
  seoTitle        String?
  seoDescription  String?
  authorLabel     String?
  brandPerspectiveMarkdown String?
  ctaTitle        String?
  ctaBody         String?
  ctaPrimaryLabel String?
  ctaPrimaryLink  String?
  ctaSecondaryLabel String?
  ctaSecondaryLink String?
  generatedWithAI Boolean   @default(false)
  reviewedByHuman Boolean   @default(false)
  publishedAt     DateTime?
  status          String    @default("draft")
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model Customer {
  id        String   @id @default(cuid())
  email     String   @unique
  firstName String
  lastName  String
  phone     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orders Order[]
}

model IntegrationEvent {
  id          String   @id @default(cuid())
  provider    String
  eventType   String
  status      String
  targetType  String?
  targetId    String?
  actorEmail  String?
  batchLabel  String?
  message     String?
  payloadJson String?
  createdAt   DateTime @default(now())
}

model SiteSetting {
  key             String   @id
  homeContentJson Json
  themeJson       Json
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model ShopcaisseProductCache {
  id                   String   @id @default(cuid())
  shopcaisseExternalKey String  @unique
  shopcaisseProductId  String
  shopcaisseVariantId  String?
  shopcaisseStoreId    String
  linkedProductId      String?
  name                 String
  sku                  String?
  barcode              String?
  imageUrl             String?
  images               Json?
  priceCents           Int?
  currency             String?
  stockQuantity        Int?
  familyName           String?
  familyId             String?
  source               String   @default("shopcaisse")
  rawJson              Json
  lastShopcaisseSyncAt DateTime
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  linkedProduct Product? @relation(fields: [linkedProductId], references: [id], onDelete: SetNull)

  @@index([shopcaisseProductId])
  @@index([shopcaisseStoreId])
  @@index([linkedProductId])
  @@index([familyId])
}

model WhatsAppConversation {
  id               String   @id @default(cuid())
  visitorSessionId String   @unique
  customerName     String?
  customerPhone    String
  consentGivenAt   DateTime
  status           String   @default("active")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  messages WhatsAppMessage[]
}

model WhatsAppMessage {
  id             String   @id @default(cuid())
  conversationId String
  direction      String
  body           String
  providerMsgId  String?  @unique
  status         String   @default("sent")
  createdAt      DateTime @default(now())

  conversation WhatsAppConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}
